ASPNETCORE_ENVIRONMENT=Development

# ==============================================
# 1. DATABASE CONFIGURATION (POSTGRESQL)
# ==============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432

IDENTITY_DB_CONNECTION="Host=localhost;Port=5432;Database=identity_db;Username=admin;Password=12345"
PRODUCT_DB_CONNECTION="Host=localhost;Port=5432;Database=product_db;Username=admin;Password=12345"
SALES_DB_CONNECTION="Host=localhost;Port=5432;Database=sales_db;Username=admin;Password=12345"
INVENTORY_DB_CONNECTION="Host=localhost;Port=5432;Database=inventory_db;Username=admin;Password=12345"
FRANCHISE_DB_CONNECTION="Host=localhost;Port=5432;Database=franchise_db;Username=admin;Password=12345"
NOTIFICATION_DB_CONNECTION="Host=localhost;Port=5432;Database=notification_db;Username=admin;Password=12345"
ENGAGEMENT_DB_CONNECTION="Host=localhost;Port=5432;Database=engagement_db;Username=admin;Password=12345"
SUPPLIER_DB_CONNECTION="Host=localhost;Port=5432;Database=supplier_db;Username=admin;Password=12345"

# ELASTICSEARCH CONFIG
ELASTIC_PORT=9200
ELASTICSEARCH_URI=http://localhost:9200

# ==============================================
# 2. CACHE CONFIGURATION (REDIS)
# ==============================================
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BLACKLIST_DB=0
REDIS_PERM_DB=1
REDIS_TIER_DB=2

# ==============================================
# 3. MESSAGE BROKER (KAFKA ECOSYSTEM)
# ==============================================
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_ID=notification-service-group
KAFKA_METADATA_REFRESH_MS=5000 # DEV: để 5s test cho sướng
# KAFKA_METADATA_REFRESH_MS=300000 # Prod: 5 phút, nhẹ nhàng cho Broker

# ==============================================
# 4. SECURITY (JWT)
# ==============================================
JWT_SECRET=
JWT_EXPIRATION=86400
JWT_ISSUER=CFSM-be
JWT_AUDIENCE=CFSM-be
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

AES_SECRET_KEY=

# ==============================================
# 5. APP PORTS (Public ra máy Host)
# ==============================================
FRONTEND_ORIGIN=http://localhost:3000
GATEWAY_PORT=8080

IDENTITY_PORT=5001
IDENTITY_SERVICE_URL=http://localhost:5001

PRODUCT_PORT=5002
PRODUCT_SERVICE_URL=http://localhost:5002

SALES_PORT=5003
SALES_SERVICE_URL=http://localhost:5003

NOTIFICATION_PORT=5004
NOTIFICATION_SERVICE_URL=http://localhost:5004

INVENTORY_PORT=5005
INVENTORY_SERVICE_URL=http://localhost:5005

FRANCHISE_PORT=5006
FRANCHISE_SERVICE_URL=http://localhost:5006

ENGAGEMENT_PORT=5007
ENGAGEMENT_SERVICE_URL=http://localhost:5007

SUPPLIER_PORT=5008
SUPPLIER_SERVICE_URL=http://localhost:5008
SUPPLIER_REST_URL=http://localhost:5023

# ==============================================
# 6. SMTP Configuration
# ==============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME= 

# VNPay config
# VNPay__TmnCode=I82PO1K0
VNPay__TmnCode=LVSLJT3X
# VNPay__HashSecret=BCXRE5Y8Y7JD0X5LJJM1NCG13PDYMMPP
VNPay__HashSecret=03I2YYHEEDHVNNQMTZM4Q3VHU7ZVJPIR
VNPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__Version=2.1.0
VNPay__Locale=vn
VNPay__CurrCode=VND
VNPay__Environment=Sandbox

#IPN - SaleService (customer orders): VNPay calls this directly → update sales_db
IpnUrl=
# IPN Supplier (purchase orders): routes through YARP proxy in SaleService → SupplierService:5008/api/vnpay/ipn

# VNPay - Orders (SalesService)
VNPay__ReturnUrl=http://localhost:5013/api/vnpay/return
VNPay__ClientReturnUrl=http://localhost:3000/orders/payment/result

# VNPay - Wallet
VNPAY__WalletVNPayReturn=http://localhost:5003/api/wallet/deposit/vnpay-return

# # VNPay - SupplierService (purchase orders)
# Dùng path /api/supplier/vnpay/* để YARP trong SaleService forward sang SupplierService:5008
VNPay__SupplierReturnUrl=http://localhost:5023/api/vnpay/return
VNPay__SupplierClientReturnUrl=http://localhost:3000/orders/payment/result

# Gateway logger
GATEWAY_LOGGER_LOG_LEVEL=debug
GATEWAY_LOGGER_FILE_LOG_NAME=./logs/dev.log
GATEWAY_LOGGER_MAX_BACKUPS=3
GATEWAY_LOGGER_MAX_AGE=30
GATEWAY_LOGGER_MAX_SIZE=100
GATEWAY_LOGGER_COMPRESS=true

# Gateway server
GATEWAY_TIMEOUT_SECONDS=180

#Cloudinary config
MAX_UPLOAD_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=